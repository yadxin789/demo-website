# ============================================================================
#  生产环境变量模板（demo-website · 五产品单入口演示站）
#  用法： cp deploy/env.production.example .env  → 填 APP_KEY / APP_URL → deploy/deploy.sh
#  关键：五产品各有自己的 SQLite 库，任何产品都不许"默认连到某个库"
# ============================================================================

APP_NAME="产品演示中心"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# 生产只记 warning 以上，避免磁盘被调试日志吃掉
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# 会话 / 缓存 / 队列 —— 必须是 file / file / sync
# SQLite 单写者：database 驱动会让每个库各建 sessions/cache/jobs 表并互相撞锁
# 三个产品共用一个浏览器会话 cookie，但登录态按 guard 分开存（HC-11：不做 SSO）
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=180
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# 五个产品各自独立的 SQLite 库（文件名，路径由 database_path() 解析）
# 禁止出现裸 DB_DATABASE
# ---------------------------------------------------------------------------
DB_CONNECTION=erp
ERP_DB_DATABASE=erp.sqlite
PM_DB_DATABASE=pm.sqlite
SHOP_DB_DATABASE=shop.sqlite
MES_DB_DATABASE=mes.sqlite
HR_DB_DATABASE=hr.sqlite

# 门户线索库：只存 leads，不读任何产品库（HC-14）
PORTAL_DB_DATABASE=portal.sqlite

# 演示站不发真实邮件：全部落日志
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 门户对外信息（页脚 / /about 展示；留空则不显示该项）
PORTAL_CONTACT_EMAIL=yadxin789@163.com
PORTAL_CONTACT_WECHAT=yadxin789
PORTAL_CONTACT_PHONE=
PORTAL_CONTACT_HOURS="工作日 9:00–18:00"
PORTAL_ICP="ICP 备案办理中"

# 演示环境不接外部支付网关
SHOP_PAYMENT_GATEWAY_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
