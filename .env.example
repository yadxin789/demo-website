APP_NAME="Demo Website"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# 会话 / 缓存 / 队列 —— 必须 file / file / sync
# SQLite 是单写者；database 驱动会让五个库各建 sessions/cache/jobs 表并互相撞锁
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# 五个产品各自独立的 SQLite 库
# 禁止出现裸 DB_DATABASE —— 任何产品都不许"默认连到某个库"
# ---------------------------------------------------------------------------
ERP_DB_DATABASE=database/erp.sqlite
PM_DB_DATABASE=database/pm.sqlite
SHOP_DB_DATABASE=database/shop.sqlite
MES_DB_DATABASE=database/mes.sqlite
HR_DB_DATABASE=database/hr.sqlite

# 门户线索库：只存 leads，不读任何产品库（HC-14）
PORTAL_DB_DATABASE=database/portal.sqlite

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="demo@yad-erp.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
